{
  "schemaVersion": "1.0.0",
  "extension": {
    "id": "preview",
    "version": "1.3.0",
    "repository": "https://github.com/bigsmartben/spec-kit-preview"
  },
  "schemas": [
    {
      "path": "schemas/preview/contract.json",
      "requiredPhrases": [
        "\"schemaVersion\"",
        "\"schemas\"",
        "\"commands\""
      ]
    },
    {
      "path": "schemas/preview/contract.schema.json",
      "requiredPhrases": [
        "Spec Kit Preview Extension Validation Contract",
        "\"schemas\"",
        "\"schemaFile\""
      ]
    },
    {
      "path": "schemas/preview/mid-ir-adapter.schema.json",
      "requiredPhrases": [
        "Spec Kit Preview Mid-Fidelity IR Adapter",
        "Preview-owned adapter schema",
        "not the upstream structured IR authority",
        "coverage_label",
        "source_refs",
        "inference_reason",
        "evidence_gaps",
        "sourceBackedProvenance",
        "gapProvenance",
        "extensions"
      ]
    }
  ],
  "commands": [
    {
      "name": "speckit.preview",
      "file": "commands/speckit.preview.md",
      "target": "specs/<feature>/preview/wireflow.html",
      "format": "html",
      "fidelityParameter": "required",
      "template": "templates/preview/wireflow.html",
      "requiredPhrases": [
        "Fidelity Parameter",
        "low|mid|high",
        "Input-to-Design Synthesis Pass",
        "spec.md Design Inputs",
        "uc.md Design Inputs",
        "Do not create Markdown",
        "self-contained",
        "network-free",
        "Escape user-provided content and source excerpts",
        "Use embedded CSS only",
        "documented interactions",
        "open design question instead of making it clickable",
        "Do not claim that HTML is production-ready"
      ],
      "forbiddenPhrases": [
        "wireflow-low",
        "wireflow-mid",
        "wireflow-high"
      ]
    }
  ],
  "sharedCommandRequiredPhrases": [
    "Command Responsibilities",
    "Evidence Policy",
    "Design Artifact Policy",
    "specs/<feature>/spec.md",
    "specs/<feature>/uc.md",
    "Do not modify source code",
    "推理补齐",
    "已覆盖",
    "输入未说明",
    "If `$ARGUMENTS` requests",
    "Create `specs/<feature>/preview/` if it is missing",
    "do not create any other files or directories",
    "Do not choose by most recent timestamp",
    "Every requirement",
    "coverage label and provenance",
    "Provenance must be either a source anchor",
    "Use `输入未说明` when no source supports",
    "Use `推理补齐` only when a minimal inference",
    "minimal traceable inference",
    "source of truth",
    "template slots",
    "already exists, read it before writing",
    "Preserve user-authored design notes",
    "Source Priority",
    "UPDATED",
    "SUPERSEDED",
    "Prefer `SPECIFY_FEATURE` when set.",
    "current Git branch name when it exactly matches",
    "unambiguous candidate directory",
    "stop and ask the user"
  ],
  "sharedCommandForbiddenPhrases": [
    "Markdown Shape",
    "HTML Shape",
    "Required tables",
    "smallest bridge needed to keep the preview understandable",
    "one single clear candidate",
    "Meaningful state changes",
    "black/white/gray wireframe language",
    "browser-friendly form",
    "without becoming production code",
    "choose the most recent feature directory",
    "Coverage evidence should name the source and a precise anchor when available",
    "prototype-only"
  ],
  "templates": [
    {
      "path": "templates/preview/wireflow.html",
      "format": "html",
      "requiredPhrases": [
        "<!doctype html>",
        "Spec Kit Preview",
        "Fidelity: {{fidelity}}",
        "输入到设计映射",
        "spec.md 设计输入映射",
        "uc.md 设计输入映射",
        "交付质量结论",
        "交互矩阵",
        "状态矩阵",
        "已保留设计记录",
        "data-fidelity",
        "data-preview-action",
        "{{node_inventory_rows}}",
        "{{interaction_matrix_rows}}",
        "{{state_matrix_rows}}",
        "{{spec_design_mapping_rows}}",
        "{{uc_design_mapping_rows}}",
        "{{quality_conclusion_rows}}",
        "{{preserved_design_records}}",
        "{{design_questions}}"
      ]
    }
  ],
  "docs": {
    "paths": [
      "README.md",
      "CATALOG-SUBMISSION.md"
    ],
    "forbiddenPhrases": [
      "speckit.preview.html",
      "speckit.preview.low-md",
      "speckit.preview.low-html",
      "speckit.preview.mid-md",
      "speckit.preview.mid-html",
      "speckit.preview.high-md",
      "speckit.preview.high-html",
      "wireflow-low",
      "wireflow-mid",
      "wireflow-high",
      "wireflow-*.md",
      "refs/tags/v1.0.0.zip"
    ]
  },
  "catalogRequiredPhrases": [
    "Extension ID: {extension.id}",
    "Name: {extension.name}",
    "Version: {extension.version}",
    "Description: {extension.description}",
    "Repository URL: {extension.repository}",
    "Download URL: {extension.repository}/archive/refs/tags/v{extension.version}.zip",
    "Required Spec Kit version: {requires.speckit_version}",
    "Commands count: {commands.count}",
    "Tags: {tags.csv}"
  ]
}
