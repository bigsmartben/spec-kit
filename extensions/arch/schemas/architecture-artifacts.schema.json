{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigsmartben/spec-kit-arch/schemas/architecture-artifacts.schema.json",
  "title": "Spec Kit Architecture Planning Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "project",
    "sections",
    "readiness"
  ],
  "properties": {
    "artifactType": {
      "type": "string",
      "enum": [
        "architecture-planning-contract"
      ]
    },
    "project": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "sourceMode": {
      "type": "string",
      "enum": [
        "generate",
        "reverse"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 9,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/architectureIntentSection"
          },
          {
            "$ref": "#/$defs/planningScopeRulesSection"
          },
          {
            "$ref": "#/$defs/capabilityBoundariesSection"
          },
          {
            "$ref": "#/$defs/requiredConstraintsSection"
          },
          {
            "$ref": "#/$defs/architectureDecisionsSection"
          },
          {
            "$ref": "#/$defs/allowedExtensionPointsSection"
          },
          {
            "$ref": "#/$defs/prohibitedPlanDirectionsSection"
          },
          {
            "$ref": "#/$defs/openArchitectureQuestionsSection"
          },
          {
            "$ref": "#/$defs/planReviewChecklistSection"
          }
        ]
      },
      "allOf": [
        {
          "$ref": "#/$defs/section-architecture-intent"
        },
        {
          "$ref": "#/$defs/section-planning-scope-rules"
        },
        {
          "$ref": "#/$defs/section-capability-boundaries"
        },
        {
          "$ref": "#/$defs/section-required-constraints"
        },
        {
          "$ref": "#/$defs/section-architecture-decisions-already-made"
        },
        {
          "$ref": "#/$defs/section-allowed-extension-points"
        },
        {
          "$ref": "#/$defs/section-prohibited-plan-directions"
        },
        {
          "$ref": "#/$defs/section-open-architecture-questions"
        },
        {
          "$ref": "#/$defs/section-plan-review-checklist"
        }
      ]
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "NEEDS ARCH UPDATE",
          "NEEDS REPO FACTS UPDATE",
          "TBD",
          "N/A",
          "none",
          "unknown"
        ]
      }
    },
    "sourceBasis": {
      "description": "Source-backed basis for a plan-facing architecture rule.",
      "allOf": [
        {
          "$ref": "#/$defs/nonEmptyText"
        }
      ]
    },
    "sectionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "records"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "records": {
          "type": "array"
        }
      }
    },
    "architectureIntentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "sourceBasis"
      ],
      "properties": {
        "intent": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "planningScopeRuleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "appliesWhen",
        "planMustDo",
        "planMustNotDo",
        "sourceBasis"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "appliesWhen": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planMustDo": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planMustNotDo": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "capabilityBoundaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityBoundary",
        "owns",
        "doesNotOwn",
        "planningImplication",
        "sourceBasis"
      ],
      "properties": {
        "capabilityBoundary": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "owns": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "doesNotOwn": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planningImplication": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "requiredConstraintRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint",
        "appliesTo",
        "planEnforcement",
        "sourceBasis"
      ],
      "properties": {
        "constraint": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "appliesTo": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planEnforcement": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "architectureDecisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "planConsequence",
        "revisitTrigger",
        "sourceBasis"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planConsequence": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "revisitTrigger": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "allowedExtensionPointRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensionPoint",
        "intendedUse",
        "requiredReviewIf",
        "sourceBasis"
      ],
      "properties": {
        "extensionPoint": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "intendedUse": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "requiredReviewIf": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "prohibitedPlanDirectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "antiPattern",
        "whyForbidden",
        "saferDirection",
        "sourceBasis"
      ],
      "properties": {
        "antiPattern": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "whyForbidden": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "saferDirection": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "openArchitectureQuestionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "planImpact",
        "requiredClarification",
        "planningStatus",
        "sourceBasis"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planImpact": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "requiredClarification": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "planningStatus": {
          "type": "string",
          "enum": [
            "BLOCKS_PLAN",
            "CAN_PROCEED_WITH_GUARDRAIL"
          ]
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "planReviewCheckRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "passCriteria",
        "blockingFailure",
        "sourceBasis"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "passCriteria": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "blockingFailure": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceBasis": {
          "$ref": "#/$defs/sourceBasis"
        }
      }
    },
    "architectureIntentSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "architecture-intent"
            },
            "title": {
              "const": "Architecture Intent"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/architectureIntentRecord"
              }
            }
          }
        }
      ]
    },
    "planningScopeRulesSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "planning-scope-rules"
            },
            "title": {
              "const": "Planning Scope Rules"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/planningScopeRuleRecord"
              }
            }
          }
        }
      ]
    },
    "capabilityBoundariesSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "capability-boundaries"
            },
            "title": {
              "const": "Capability Boundaries"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/capabilityBoundaryRecord"
              }
            }
          }
        }
      ]
    },
    "requiredConstraintsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "required-constraints"
            },
            "title": {
              "const": "Required Constraints"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/requiredConstraintRecord"
              }
            }
          }
        }
      ]
    },
    "architectureDecisionsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "architecture-decisions-already-made"
            },
            "title": {
              "const": "Architecture Decisions Already Made"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/architectureDecisionRecord"
              }
            }
          }
        }
      ]
    },
    "allowedExtensionPointsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "allowed-extension-points"
            },
            "title": {
              "const": "Allowed Extension Points"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/allowedExtensionPointRecord"
              }
            }
          }
        }
      ]
    },
    "prohibitedPlanDirectionsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "prohibited-plan-directions"
            },
            "title": {
              "const": "Prohibited Plan Directions"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/prohibitedPlanDirectionRecord"
              }
            }
          }
        }
      ]
    },
    "openArchitectureQuestionsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "open-architecture-questions"
            },
            "title": {
              "const": "Open Architecture Questions"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/openArchitectureQuestionRecord"
              }
            }
          }
        }
      ]
    },
    "planReviewChecklistSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "id": {
              "const": "plan-review-checklist"
            },
            "title": {
              "const": "Plan Review Checklist"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/planReviewCheckRecord"
              }
            }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planningGate",
        "blockers"
      ],
      "properties": {
        "planningGate": {
          "type": "string",
          "enum": [
            "USABLE",
            "BLOCKED"
          ]
        },
        "readyGate": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "planningGate": {
                "const": "USABLE"
              }
            },
            "required": [
              "planningGate"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "planningGate": {
                "const": "BLOCKED"
              }
            },
            "required": [
              "planningGate"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/blockerCode"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "artifact": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sectionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "blockerCode": {
      "type": "string",
      "enum": [
        "ARCH_ARTIFACT_MISSING",
        "ARCH_PLACEHOLDER_PRESENT",
        "ARCH_REQUIRED_SECTION_MISSING",
        "ARCH_REQUIRED_SECTION_EMPTY",
        "ARCH_PLANNING_SCOPE_RULES_MISSING",
        "ARCH_CAPABILITY_BOUNDARIES_MISSING",
        "ARCH_CONSTRAINTS_OR_DECISIONS_MISSING",
        "ARCH_PLAN_REVIEW_CHECKLIST_MISSING",
        "ARCH_SOURCE_MISSING",
        "ARCH_GIT_HISTORY_ONLY",
        "ARCH_UNSUPPORTED_CONCLUSION",
        "ARCH_OPEN_QUESTION_STATUS_INVALID"
      ]
    },
    "contains-section": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "section-architecture-intent": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "architecture-intent"
              }
            }
          }
        ]
      }
    },
    "section-planning-scope-rules": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "planning-scope-rules"
              }
            }
          }
        ]
      }
    },
    "section-capability-boundaries": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "capability-boundaries"
              }
            }
          }
        ]
      }
    },
    "section-required-constraints": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "required-constraints"
              }
            }
          }
        ]
      }
    },
    "section-architecture-decisions-already-made": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "architecture-decisions-already-made"
              }
            }
          }
        ]
      }
    },
    "section-allowed-extension-points": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "allowed-extension-points"
              }
            }
          }
        ]
      }
    },
    "section-prohibited-plan-directions": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "prohibited-plan-directions"
              }
            }
          }
        ]
      }
    },
    "section-open-architecture-questions": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "open-architecture-questions"
              }
            }
          }
        ]
      }
    },
    "section-plan-review-checklist": {
      "contains": {
        "allOf": [
          {
            "$ref": "#/$defs/contains-section"
          },
          {
            "properties": {
              "id": {
                "const": "plan-review-checklist"
              }
            }
          }
        ]
      }
    }
  }
}
